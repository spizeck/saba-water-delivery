rules_version = '2';

// Production Firestore Security Rules.
//
// Direct client access is limited to the minimum data required by each
// authenticated role. Operational mutations and sanitized oversight views
// run through server-authorized domain code using the Firebase Admin SDK.
// Unknown collections and all unlisted operations are denied by default.
//
// The user model supports multiple roles per user via a `roles` array.
// Queries must match these document-level constraints because Firestore
// rules reject, rather than filter, an overly broad query.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRoles() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function hasRole(r) {
      return isSignedIn() && r in userRoles();
    }

    function isStaff() {
      return hasRole('dispatcher') || hasRole('admin');
    }

    // Users may read their own profile; staff may read the directory for
    // operational support. Profile creation, role changes, confirmation
    // timestamps, account state, and auditing remain server-only. A direct
    // owner update can affect only the four resident-editable profile fields.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if false;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'phone',
          'village',
          'deliveryDirections'
        ]);
      allow delete: if false;

      // Photo functionality is not active. Metadata remains locked down in
      // step with the deny-all Storage rules until an end-to-end access model
      // and retention policy are implemented.
      match /propertyPhotos/{photoId} {
        allow read, write: if false;
      }
    }

    // Government-managed Driver Registry. Staff may read operational
    // records directly; all writes remain server-only. Viewer oversight is
    // projected by trusted server code so raw phone, linked account IDs,
    // meters, and registry audit records are not directly accessible.
    match /driverRegistry/{driverId} {
      allow read: if isStaff();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }

      match /meters/{stationId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Fill stations are simple, non-sensitive reference data.
    match /fillStations/{stationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Water requests: default-deny direct writes. Creation and every
    // state transition (claim, deliver, confirm, dispute, cancel) must go
    // through server-side domain functions so business rules and
    // concurrency guarantees (see TECHNICAL.md "Request Claiming") are
    // enforced consistently.
    //
    // Dispatcher-created requests for unregistered/manual customers store
    // `customerId: null` (see TECHNICAL.md "Dispatcher-Created Requests").
    // The `resource.data.customerId == request.auth.uid` comparison below
    // is still safe for those documents: `request.auth.uid` is always a
    // non-null string for a signed-in user, so it can never equal `null`
    // — an unrelated resident cannot read another customer's unregistered
    // request through this rule. Staff access is unaffected either way.
    match /waterRequests/{requestId} {
      // Residents may read their own request and an assigned driver may read
      // the request needed to deliver it. Staff retain operational access.
      // Viewer oversight uses a sanitized server-side projection and therefore
      // does not require direct access to raw customer/request documents.
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || resource.data.assignedDriverId == request.auth.uid
          || isStaff());
      allow write: if false;

      // Raw audit events include staff corrections, assignment history,
      // operational reasons, and internal identifiers. Only operational staff
      // may read them directly; resident/driver history must be projected by
      // trusted server code if introduced in their portals.
      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }

      // Request-photo functionality is not active and Storage is deny-all.
      // Keep metadata inaccessible until binary access, retention, and role
      // checks are implemented together.
      match /photos/{photoId} {
        allow read, write: if false;
      }
    }

    // Driver dispatch offers are selected and responded to through trusted
    // server code. Drivers do not need direct access to raw offer history;
    // staff retain read access for operational support.
    match /driverOffers/{offerId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Application configuration (e.g. dispatch settings). All writes go
    // through trusted server-side admin actions. Staff may read current
    // values; admin-only mutation is enforced at the application layer.
    match /config/{configId} {
      allow read: if isStaff();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Delivery runs are managed through server-side domain logic. Staff may
    // read raw run state; viewer summaries are produced server-side without
    // exposing run membership or internal audit details.
    match /dispatchBatches/{batchId} {
      allow read: if isStaff();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // WhatsApp conversation sessions (ephemeral conversation scratch
    // state, never the authoritative water-request record — see
    // TECHNICAL.md "WhatsApp Resident Ordering") and inbound-webhook
    // idempotency ledger. Read/written only by the webhook route via
    // the Admin SDK, which bypasses these rules entirely — no client
    // (resident, driver, or staff) ever needs to read these directly,
    // so both are fully deny-by-default rather than staff-readable.
    match /whatsappSessions/{sessionId} {
      allow read, write: if false;
    }
    match /whatsappProcessedMessages/{messageId} {
      allow read, write: if false;
    }

    // Account merge audit records. Written and read only by server-side
    // admin domain logic via the Firebase Admin SDK. No client access.
    match /accountMergeEvents/{eventId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
