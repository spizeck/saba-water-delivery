rules_version = '2';

// Firestore Security Rules.
//
// This is a foundation, not a complete rule set. It establishes the
// deny-by-default posture and role model described in TECHNICAL.md so
// that collections are not accidentally left open while the schema is
// built out. Rules should be revisited and tightened per-collection as
// each workflow (requests, claiming, driver management, etc.) is
// implemented — see TECHNICAL.md "Firestore Security".
//
// The user model supports multiple roles per user via a `roles` array.
// Legacy documents may still use a singular `role` field; the helper
// functions below handle both formats.
//
// Do not assume these rules alone are sufficient; queries and rules must
// be designed together (Security Rules cannot filter an overly broad
// query, only reject it).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns the user's roles array. Handles both the new `roles` array
    // format and the legacy singular `role` field for backward compat.
    function userRoles() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('roles' in userData && userData.roles is list)
        ? userData.roles
        : [userData.role];
    }

    function hasRole(r) {
      return isSignedIn() && r in userRoles();
    }

    function isStaff() {
      return hasRole('dispatcher') || hasRole('admin');
    }

    // `viewer` is a read-only oversight role — never combined with
    // isStaff(), which implies operational/mutation capability. Viewer
    // must NOT gain access to the admin user directory or driver
    // registry contact details (see TECHNICAL.md "Viewer Role").
    function isViewer() {
      return hasRole('viewer');
    }

    // Users can read/update their own profile. Role changes must go
    // through trusted server-side (Admin SDK) code, not direct writes.
    //
    // In practice the app provisions and updates user documents through
    // the Admin SDK (see src/lib/domain/users.ts), which bypasses these
    // rules entirely. These rules exist as defense in depth in case a
    // client ever writes to Firestore directly: a new user can create
    // only their own document and only with roles: ["resident"], and no
    // client write can ever modify the roles field on an existing doc.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'resident';
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.roles == resource.data.roles;
      allow delete: if false;

      // Property photo metadata. The owning resident may manage their
      // own photos. Staff may read for operational support. Driver read
      // access requires a verified delivery relationship — until that
      // check is implemented, driver reads are denied here and photo
      // access should be mediated through server-side signed URLs.
      match /propertyPhotos/{photoId} {
        allow read: if isSignedIn()
          && (request.auth.uid == userId || isStaff());
        allow create, update: if isSignedIn()
          && request.auth.uid == userId;
        allow delete: if isSignedIn()
          && request.auth.uid == userId;
      }
    }

    // LEGACY pre-Driver-Registry collection, keyed by uid. Superseded by
    // `driverRegistry/{id}` (below), which is keyed independently so a
    // driver can be entered before they have an account — see
    // TECHNICAL.md "Driver Registry". Retained read-only for historical
    // data; no new code should write here.
    match /drivers/{driverId} {
      allow read: if isSignedIn() && (request.auth.uid == driverId || isStaff());
      allow write: if false;
    }

    // Government-managed Driver Registry. All writes (create, edit,
    // link/unlink account, restrict/restore, meter assignments) go
    // through trusted server-side domain logic
    // (src/lib/domain/driverRegistry.ts) — never a direct client write,
    // and never self-service by a normal user. Staff and viewers may
    // read for operational oversight; viewers get the same document as
    // staff here since a driver's registry entry does not contain
    // resident PII (only the driver's own name/phone, which staff can
    // already see operationally).
    match /driverRegistry/{driverId} {
      allow read: if isStaff() || isViewer();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isStaff() || isViewer();
        allow write: if false;
      }

      match /meters/{stationId} {
        allow read: if isStaff() || isViewer();
        allow write: if false;
      }
    }

    // Fill stations are simple, non-sensitive reference data.
    match /fillStations/{stationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Water requests: default-deny direct writes. Creation and every
    // state transition (claim, deliver, confirm, dispute, cancel) must go
    // through server-side domain functions so business rules and
    // concurrency guarantees (see TECHNICAL.md "Request Claiming") are
    // enforced consistently.
    //
    // Dispatcher-created requests for unregistered/manual customers store
    // `customerId: null` (see TECHNICAL.md "Dispatcher-Created Requests").
    // The `resource.data.customerId == request.auth.uid` comparison below
    // is still safe for those documents: `request.auth.uid` is always a
    // non-null string for a signed-in user, so it can never equal `null`
    // — an unrelated resident cannot read another customer's unregistered
    // request through this rule. Staff access is unaffected either way.
    match /waterRequests/{requestId} {
      // Viewer gets the same read access as staff for oversight (see
      // PRODUCT.md "Viewer Role") — request documents contain the
      // requesting customer's own contact info, which is a normal part
      // of an operational request record, not a separate admin
      // directory. The Viewer UI itself chooses to display only a
      // reduced projection (see src/app/viewer/page.tsx); this rule is
      // defense-in-depth for the underlying document, matching how
      // staff access already works.
      allow read: if isSignedIn()
        && (resource.data.customerId == request.auth.uid
          || resource.data.assignedDriverId == request.auth.uid
          || isStaff()
          || isViewer());
      allow write: if false;

      match /events/{eventId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/waterRequests/$(requestId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/waterRequests/$(requestId)).data.assignedDriverId == request.auth.uid
            || isStaff()
            || isViewer());
        allow write: if false;
      }

      // Request photo metadata (proof of delivery, issue documentation).
      // The assigned driver, the customer, and staff may read. Only the
      // assigned driver may create. Updates and deletes are denied until
      // a retention policy is defined.
      match /photos/{photoId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/waterRequests/$(requestId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/waterRequests/$(requestId)).data.assignedDriverId == request.auth.uid
            || isStaff());
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/waterRequests/$(requestId)).data.assignedDriverId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Driver dispatch offers (one-request-at-a-time offer workflow). All
    // creation and response recording happens through server-side domain
    // logic (see src/lib/domain/dispatch.ts, driverOffers.ts). A driver may
    // read their own offer history; staff may read for operational support.
    match /driverOffers/{offerId} {
      allow read: if isSignedIn()
        && (resource.data.driverId == request.auth.uid || isStaff());
      allow write: if false;
    }

    // Application configuration (e.g. dispatch settings). All writes go
    // through trusted server-side admin actions. Staff may read current
    // values; admin-only mutation is enforced at the application layer.
    match /config/{configId} {
      allow read: if isStaff();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isStaff();
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
