[debug] [2026-09-01T15:44:14.978Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/saba-water-delivery/rulesets {"name":"projects/saba-water-delivery/rulesets/0c8806e6-d444-40bc-a90e-88fc3acfe163","source":{"files":[{"content":"rules_version = '2';\n\n// Firebase Storage Security Rules.\n//\n// Deny-by-default scaffold. Photo upload/download capabilities are\n// planned but not yet implemented. These rules ensure that Storage is\n// locked down until the access-control logic described in TECHNICAL.md\n// \"Firebase Storage\" is built out.\n//\n// When implementing photo uploads, replace specific match blocks below\n// with rules that enforce:\n//\n//   Property photos  — resident owns the path; drivers read only when\n//                      they hold an assigned delivery for that resident\n//                      (may require server-side signed URLs instead of\n//                      direct Storage Rules if cross-referencing\n//                      Firestore is impractical).\n//\n//   Request photos   — only the assigned driver may write; the assigned\n//                      driver, the customer, and staff may read.\n//\n// General principles:\n//   - Never expose permanent unrestricted download URLs.\n//   - Use opaque identifiers in paths, not personal data.\n//   - Prefer short-lived signed URLs generated server-side when Storage\n//     Rules alone cannot express the required access check.\n//\n// See also: firestore.rules for Firestore-side photo metadata rules.\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n\n    // Property photos: users/{uid}/property-photos/{photoId}\n    // Locked down until implementation. Will require:\n    //   - Owner (uid) may read/write/delete.\n    //   - Drivers may read only with a verified delivery relationship.\n    //   - Staff may read for operational support.\n    match /property-photos/{uid}/{photoId} {\n      allow read, write: if false;\n    }\n\n    // Request photos: request-photos/{requestId}/{photoId}\n    // Locked down until implementation. Will require:\n    //   - Assigned driver may write.\n    //   - Assigned driver, customer, and staff may read.\n    match /request-photos/{requestId}/{photoId} {\n      allow read, write: if false;\n    }\n\n    // Deny everything else by default.\n    match /{allPaths=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-09-01T15:44:14.151759Z","metadata":{"services":["firebase.storage"]}}
