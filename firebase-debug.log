[debug] [2026-09-01T15:44:15.732Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/saba-water-delivery/rulesets 200
[debug] [2026-09-01T15:44:15.733Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/saba-water-delivery/rulesets {"name":"projects/saba-water-delivery/rulesets/d24c417e-aa1b-4400-a46e-c05657751185","source":{"files":[{"content":"rules_version = '2';\r\n\r\n// Production Firestore Security Rules.\r\n//\r\n// Direct client access is limited to the minimum data required by each\r\n// authenticated role. Operational mutations and sanitized oversight views\r\n// run through server-authorized domain code using the Firebase Admin SDK.\r\n// Unknown collections and all unlisted operations are denied by default.\r\n//\r\n// The user model supports multiple roles per user via a `roles` array.\r\n// Queries must match these document-level constraints because Firestore\r\n// rules reject, rather than filter, an overly broad query.\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function userRoles() {\r\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;\r\n    }\r\n\r\n    function hasRole(r) {\r\n      return isSignedIn() && r in userRoles();\r\n    }\r\n\r\n    function isStaff() {\r\n      return hasRole('dispatcher') || hasRole('admin');\r\n    }\r\n\r\n    // Users may read their own profile; staff may read the directory for\r\n    // operational support. Profile creation, role changes, confirmation\r\n    // timestamps, account state, and auditing remain server-only. A direct\r\n    // owner update can affect only the four resident-editable profile fields.\r\n    match /users/{userId} {\r\n      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());\r\n      allow create: if false;\r\n      allow update: if isSignedIn()\r\n        && request.auth.uid == userId\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'displayName',\r\n          'phone',\r\n          'village',\r\n          'deliveryDirections'\r\n        ]);\r\n      allow delete: if false;\r\n\r\n      // Photo functionality is not active. Metadata remains locked down in\r\n      // step with the deny-all Storage rules until an end-to-end access model\r\n      // and retention policy are implemented.\r\n      match /propertyPhotos/{photoId} {\r\n        allow read, write: if false;\r\n      }\r\n    }\r\n\r\n    // Government-managed Driver Registry. Staff may read operational\r\n    // records directly; all writes remain server-only. Viewer oversight is\r\n    // projected by trusted server code so raw phone, linked account IDs,\r\n    // meters, and registry audit records are not directly accessible.\r\n    match /driverRegistry/{driverId} {\r\n      allow read: if isStaff();\r\n      allow write: if false;\r\n\r\n      match /events/{eventId} {\r\n        allow read: if isStaff();\r\n        allow write: if false;\r\n      }\r\n\r\n      match /meters/{stationId} {\r\n        allow read: if isStaff();\r\n        allow write: if false;\r\n      }\r\n    }\r\n\r\n    // Fill stations are simple, non-sensitive reference data.\r\n    match /fillStations/{stationId} {\r\n      allow read: if isSignedIn();\r\n      allow write: if false;\r\n    }\r\n\r\n    // Water requests: default-deny direct writes. Creation and every\r\n    // state transition (claim, deliver, confirm, dispute, cancel) must go\r\n    // through server-side domain functions so business rules and\r\n    // concurrency guarantees (see TECHNICAL.md \"Request Claiming\") are\r\n    // enforced consistently.\r\n    //\r\n    // Dispatcher-created requests for unregistered/manual customers store\r\n    // `customerId: null` (see TECHNICAL.md \"Dispatcher-Created Requests\").\r\n    // The `resource.data.customerId == request.auth.uid` comparison below\r\n    // is still safe for those documents: `request.auth.uid` is always a\r\n    // non-null string for a signed-in user, so it can never equal `null`\r\n    // — an unrelated resident cannot read another customer's unregistered\r\n    // request through this rule. Staff access is unaffected either way.\r\n    match /waterRequests/{requestId} {\r\n      // Residents may read their own request and an assigned driver may read\r\n      // the request needed to deliver it. Staff retain operational access.\r\n      // Viewer oversight uses a sanitized server-side projection and therefore\r\n      // does not require direct access to raw customer/request documents.\r\n      allow read: if isSignedIn()\r\n        && (resource.data.customerId == request.auth.uid\r\n          || resource.data.assignedDriverId == request.auth.uid\r\n          || isStaff());\r\n      allow write: if false;\r\n\r\n      // Raw audit events include staff corrections, assignment history,\r\n      // operational reasons, and internal identifiers. Only operational staff\r\n      // may read them directly; resident/driver history must be projected by\r\n      // trusted server code if introduced in their portals.\r\n      match /events/{eventId} {\r\n        allow read: if isStaff();\r\n        allow write: if false;\r\n      }\r\n\r\n      // Request-photo functionality is not active and Storage is deny-all.\r\n      // Keep metadata inaccessible until binary access, retention, and role\r\n      // checks are implemented together.\r\n      match /photos/{photoId} {\r\n        allow read, write: if false;\r\n      }\r\n    }\r\n\r\n    // Driver dispatch offers are selected and responded to through trusted\r\n    // server code. Drivers do not need direct access to raw offer history;\r\n    // staff retain read access for operational support.\r\n    match /driverOffers/{offerId} {\r\n      allow read: if isStaff();\r\n      allow write: if false;\r\n    }\r\n\r\n    // Application configuration (e.g. dispatch settings). All writes go\r\n    // through trusted server-side admin actions. Staff may read current\r\n    // values; admin-only mutation is enforced at the application layer.\r\n    match /config/{configId} {\r\n      allow read: if isStaff();\r\n      allow write: if false;\r\n\r\n      match /events/{eventId} {\r\n        allow read: if isStaff();\r\n        allow write: if false;\r\n      }\r\n    }\r\n\r\n    // Delivery runs are managed through server-side domain logic. Staff may\r\n    // read raw run state; viewer summaries are produced server-side without\r\n    // exposing run membership or internal audit details.\r\n    match /dispatchBatches/{batchId} {\r\n      allow read: if isStaff();\r\n      allow write: if false;\r\n\r\n      match /events/{eventId} {\r\n        allow read: if isStaff();\r\n        allow write: if false;\r\n      }\r\n    }\r\n\r\n    // WhatsApp conversation sessions (ephemeral conversation scratch\r\n    // state, never the authoritative water-request record — see\r\n    // TECHNICAL.md \"WhatsApp Resident Ordering\") and inbound-webhook\r\n    // idempotency ledger. Read/written only by the webhook route via\r\n    // the Admin SDK, which bypasses these rules entirely — no client\r\n    // (resident, driver, or staff) ever needs to read these directly,\r\n    // so both are fully deny-by-default rather than staff-readable.\r\n    match /whatsappSessions/{sessionId} {\r\n      allow read, write: if false;\r\n    }\r\n    match /whatsappProcessedMessages/{messageId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // Account merge audit records. Written and read only by server-side\r\n    // admin domain logic via the Firebase Admin SDK. No client access.\r\n    match /accountMergeEvents/{eventId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // Deny everything else by default.\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-09-01T15:44:14.909647Z","metadata":{"services":["cloud.firestore"]}}
