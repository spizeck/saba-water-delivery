# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Firebase client SDK (safe to expose to the browser) ---------------
# Find these in Firebase Console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret) ----------------------
# Generate a service account key in Firebase Console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n sequences for newlines, e.g.:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Nightly operational continuity snapshot (server-only) --------------
# See PRODUCT.md / TECHNICAL.md "Operational Continuity Snapshot".
#
# Protects /api/cron/continuity-report from being triggered by an
# arbitrary public request. When set, Vercel Cron automatically sends
# `Authorization: Bearer <CRON_SECRET>` on its scheduled invocation — set
# this to a long random value in the Vercel project's environment
# variables (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# SMTP credentials used to email the nightly/manual continuity report
# PDF. Works with any SMTP provider (Google Workspace, Microsoft 365,
# SendGrid/SES SMTP relay, etc.) — no specific vendor SDK required.
CONTINUITY_REPORT_SMTP_HOST=
CONTINUITY_REPORT_SMTP_PORT=
# "true" for an implicit-TLS port (typically 465); "false" (or unset)
# for STARTTLS ports (typically 587).
CONTINUITY_REPORT_SMTP_SECURE=
CONTINUITY_REPORT_SMTP_USER=
CONTINUITY_REPORT_SMTP_PASSWORD=

# From/To addresses for the continuity report email. The recipient is
# intentionally configurable, never hard-coded in source — set it to a
# government distribution list or shared operational inbox, not a
# personal address.
CONTINUITY_REPORT_EMAIL_FROM=
CONTINUITY_REPORT_EMAIL_TO=
