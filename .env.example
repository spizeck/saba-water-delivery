# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Firebase client SDK (safe to expose to the browser) ---------------
# Find these in Firebase Console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret) ----------------------
# Generate a service account key in Firebase Console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n sequences for newlines, e.g.:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Nightly operational continuity snapshot (server-only) --------------
# See PRODUCT.md / TECHNICAL.md "Operational Continuity Snapshot".
#
# Protects /api/cron/continuity-report from being triggered by an
# arbitrary public request. This value is required; the route fails closed
# when it is missing. Vercel Cron automatically sends `Authorization: Bearer
# <CRON_SECRET>` on its scheduled invocation. Set this to a long random value
# in the Vercel project's environment
# variables (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Resend (https://resend.com) API key used to email the nightly/manual
# continuity report PDF. Create one at Resend > API Keys. Server-only —
# never expose this with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# From/To addresses for the continuity report email.
#
# CONTINUITY_REPORT_EMAIL_FROM must be an address on a domain verified
# in Resend (Resend > Domains) — it cannot be an arbitrary/personal
# address until that domain is verified. Until a government domain is
# verified, Resend's own onboarding sender (e.g.
# "onboarding@resend.dev") can be used for testing only.
#
# CONTINUITY_REPORT_EMAIL_TO is a comma-separated list (whitespace
# around each address is trimmed), e.g.:
#   CONTINUITY_REPORT_EMAIL_TO=person1@example.com,person2@example.com
# The recipient is intentionally configurable, never hard-coded in
# source — set it to a government distribution list or shared
# operational inbox, not a personal address.
CONTINUITY_REPORT_EMAIL_FROM=
CONTINUITY_REPORT_EMAIL_TO=

# Optional public application URL, used for password-reset/setup links in
# account-invitation emails and for the deterministic PWA QR codes shown on
# the admin QR-codes page. Set this to the canonical public production origin
# (e.g. https://waterdelivery.saba.gov) so printed codes never point to a
# temporary preview/deployment URL. Falls back to the production Vercel domain
# in some contexts if not set.
NEXT_PUBLIC_APP_URL=

# Account setup invitation emails (dispatcher-initiated resident
# onboarding). Reuses RESEND_API_KEY. If ACCOUNT_SETUP_EMAIL_FROM is not
# set, the sender falls back to CONTINUITY_REPORT_EMAIL_FROM.
ACCOUNT_SETUP_EMAIL_FROM=

# --- WhatsApp resident ordering (server-only) ----------------------------
# See PRODUCT.md / TECHNICAL.md "WhatsApp Resident Ordering". Uses the
# Meta WhatsApp Business Platform (Cloud API) via Meta's Graph API — no
# third-party WhatsApp provider (e.g. Twilio).
#
# Long-lived access token for the Cloud API (Meta App Dashboard >
# WhatsApp > API Setup, or a System User token for production so it
# doesn't expire like the default 24-hour test token).
WHATSAPP_ACCESS_TOKEN=
# The Phone Number ID (NOT the phone number itself) shown in Meta App
# Dashboard > WhatsApp > API Setup for the number sending/receiving
# messages.
WHATSAPP_PHONE_NUMBER_ID=
# App secret from Meta App Dashboard > App Settings > Basic. Used to
# verify the `X-Hub-Signature-256` header on every inbound webhook
# call so requests cannot be spoofed.
WHATSAPP_APP_SECRET=
# Any long random string you choose yourself (e.g. `openssl rand -hex
# 32`) and also enter in Meta App Dashboard > WhatsApp > Configuration
# > Webhook when subscribing the callback URL. Meta echoes this back
# during the verification handshake; it is not provided by Meta.
WHATSAPP_VERIFY_TOKEN=
