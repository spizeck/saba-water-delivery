# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file containing real secrets.
#
# The single canonical reference for every variable — its classification
# (public/server/secret), which environments require it, what happens when it is
# missing, and whether a redeploy is needed — is the table in
# docs/DEPLOYMENT.md "Canonical configuration table", which mirrors the typed
# registry in src/lib/config/serverConfig.ts (see docs/adr/0016).

# --- Firebase client SDK (safe to expose to the browser) ---------------
# Find these in Firebase Console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret) ----------------------
# Generate a service account key in Firebase Console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n sequences for newlines, e.g.:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional. Which Firestore database the trusted server uses. Leave UNSET in
# normal operation — the app uses the project's `(default)` database. It exists
# only as a disaster-recovery override: after a managed restore into a
# differently-named database (e.g. `recovery-20260912`), set this in Vercel to
# point the deployed app at the validated restore without a code change, then
# clear it once consolidated back to `(default)`. See docs/DISASTER_RECOVERY.md.
FIREBASE_DATABASE_ID=

# --- Nightly operational continuity snapshot (server-only) --------------
# See PRODUCT.md / TECHNICAL.md "Operational Continuity Snapshot".
#
# Protects /api/cron/continuity-report from being triggered by an
# arbitrary public request. This value is required; the route fails closed
# when it is missing. Vercel Cron automatically sends `Authorization: Bearer
# <CRON_SECRET>` on its scheduled invocation. Set this to a long random value
# in the Vercel project's environment
# variables (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Resend (https://resend.com) API key used for all outbound email
# (continuity report, account-setup invitations, delivery confirmations).
# Server-only — never expose this with a NEXT_PUBLIC_ prefix.
#
# Deployed (Vercel) environments receive RESEND_API_KEY automatically from
# the Vercel-managed Resend integration (Vercel → Integrations → Resend);
# do not set it by hand there. The integration also injects
# RESEND_EMAIL_DOMAIN — the domain it verified for sending. The app does
# not read RESEND_EMAIL_DOMAIN: sender identity is the explicit
# *_EMAIL_FROM addresses below, which carry a display name and mailbox a
# bare domain cannot express. For local development, create a key at
# Resend > API Keys and set it here.
RESEND_API_KEY=

# From/To addresses for the continuity report email.
#
# CONTINUITY_REPORT_EMAIL_FROM must be an address on a domain verified
# in Resend (Resend > Domains) — it cannot be an arbitrary/personal
# address until that domain is verified. Until a government domain is
# verified, Resend's own onboarding sender (e.g.
# "onboarding@resend.dev") can be used for testing only.
#
# CONTINUITY_REPORT_EMAIL_TO is a comma-separated list (whitespace
# around each address is trimmed), e.g.:
#   CONTINUITY_REPORT_EMAIL_TO=person1@example.com,person2@example.com
# The recipient is intentionally configurable, never hard-coded in
# source — set it to a government distribution list or shared
# operational inbox, not a personal address.
CONTINUITY_REPORT_EMAIL_FROM=
CONTINUITY_REPORT_EMAIL_TO=
# Optional sender for delivery confirmation emails. Falls back to
# CONTINUITY_REPORT_EMAIL_FROM when omitted.
DELIVERY_CONFIRMATION_EMAIL_FROM=

# Optional public application URL, used for password-reset/setup links in
# account-invitation emails and for the deterministic PWA QR codes shown on
# the admin QR-codes page. Set this to the canonical public production origin
# During the pilot this is https://saba-water-delivery.vercel.app. Update it
# to the permanent government URL after DNS is configured so newly generated
# links and QR codes use that domain. Never use a temporary preview URL.
NEXT_PUBLIC_APP_URL=https://saba-water-delivery.vercel.app

# Account setup invitation emails (dispatcher-initiated resident
# onboarding). Reuses RESEND_API_KEY. If ACCOUNT_SETUP_EMAIL_FROM is not
# set, the sender falls back to CONTINUITY_REPORT_EMAIL_FROM.
ACCOUNT_SETUP_EMAIL_FROM=

# --- WhatsApp resident ordering (server-only) ----------------------------
# See PRODUCT.md / TECHNICAL.md "WhatsApp Resident Ordering". Uses the
# Meta WhatsApp Business Platform (Cloud API) via Meta's Graph API — no
# third-party WhatsApp provider (e.g. Twilio).
#
# Long-lived access token for the Cloud API (Meta App Dashboard >
# WhatsApp > API Setup, or a System User token for production so it
# doesn't expire like the default 24-hour test token).
WHATSAPP_ACCESS_TOKEN=
# The Phone Number ID (NOT the phone number itself) shown in Meta App
# Dashboard > WhatsApp > API Setup for the number sending/receiving
# messages.
WHATSAPP_PHONE_NUMBER_ID=
# App secret from Meta App Dashboard > App Settings > Basic. Used to
# verify the `X-Hub-Signature-256` header on every inbound webhook
# call so requests cannot be spoofed.
WHATSAPP_APP_SECRET=
# Any long random string you choose yourself (e.g. `openssl rand -hex
# 32`) and also enter in Meta App Dashboard > WhatsApp > Configuration
# > Webhook when subscribing the callback URL. Meta echoes this back
# during the verification handshake; it is not provided by Meta.
WHATSAPP_VERIFY_TOKEN=

# --- Sentry error monitoring (optional; issue #115; PRODUCTION ONLY) ---
# See docs/DEPLOYMENT.md "Canonical configuration table" and
# docs/OPERATIONS.md "Error monitoring (Sentry)".
#
# Sentry is intentionally enabled in Production ONLY — the runtime gate
# (resolveSentryEnv in src/lib/monitoring/sentryShared.ts) enables it only
# when the deployment environment resolves to `production`, so Preview,
# local dev, and CI send nothing even if these variables are set. When
# NEXT_PUBLIC_SENTRY_DSN is absent the integration also disables cleanly —
# local dev/CI need nothing here.
#
# PROJECT-SPECIFIC: the public DSN for this app's Sentry project (Sentry >
# Project Settings > Client Keys/DSN). Public by design — it only identifies
# the ingest endpoint and grants no read access. In Vercel, scope it to the
# Production environment only. Client events are forwarded through the
# same-origin `/sentry-tunnel` route, so no CSP change is needed.
NEXT_PUBLIC_SENTRY_DSN=
# PROJECT-SPECIFIC slug identifying this app's Sentry project.
SENTRY_PROJECT=
# SHARED org slug + auth token — intentionally reused across projects/builds
# under the same Sentry organization ("shared" does NOT mean public).
SENTRY_ORG=
# SENTRY_AUTH_TOKEN is a SECRET, BUILD-TIME-ONLY credential (org token with
# `project:releases` scope) used by `withSentryConfig` to upload source maps
# on Production builds. Set it in Vercel for the Production environment,
# never NEXT_PUBLIC_, never committed. Without it the build still succeeds
# and Production errors are still captured; stack traces are just not
# symbolicated. Preview builds never upload source maps by policy.
SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT / NEXT_PUBLIC_SENTRY_RELEASE /
# NEXT_PUBLIC_SENTRY_DEPLOYMENT_ID are derived automatically from Vercel's
# VERCEL_ENV / VERCEL_GIT_COMMIT_SHA / VERCEL_DEPLOYMENT_ID in
# next.config.ts — do not set them by hand.

# --- Optional operational configuration ---

# Minimum level for structured operational logs: debug | info | warn |
# error. Optional and NOT required for the app to run. Defaults to `info`
# in production and `debug` otherwise. Set to `debug` temporarily when
# diagnosing a production issue. See docs/DEPLOYMENT.md and TECHNICAL.md
# ("Operational logging and observability").
LOG_LEVEL=

# Content-Security-Policy rollout valve. Optional and NOT required. When set
# to any truthy value, the app emits `Content-Security-Policy-Report-Only`
# instead of the enforcing header, so violations are reported to the browser
# console without blocking anything — useful for a cautious rollout. Leave
# unset (or "false") to ENFORCE the CSP (the default). Read at build time, so
# a change requires a redeploy. See TECHNICAL.md "Browser security headers".
CSP_REPORT_ONLY=

# Secret used to HMAC-hash rate-limit identifiers (e.g. IP addresses) before
# they are used as Firestore bucket keys, so a raw identifier is never stored
# and cannot be reversed from the key. REQUIRED in deployed Vercel environments
# (Production AND Preview) — this repo is public, so there is no built-in salt
# that could protect a small-space value like an IP. Give Production and Preview
# each their own unique random value (e.g. `openssl rand -hex 32`) via Vercel
# environment variables. If it is missing in a deployed environment the limiter
# treats itself as unavailable and fails OPEN (logs `rate_limit.secret_missing`
# and allows the request) — it never blocks auth/water delivery and never hashes
# with a repo-known salt. Local development and tests use a deterministic
# dev-only fallback (no secret needed); that fallback is NOT a production
# privacy control. It is a SECRET — do not commit a real value. Rotating it
# resets in-flight limiter windows (harmless — they re-fill). Do NOT reuse
# CRON_SECRET, the Firebase private key, or any WhatsApp/Resend secret. See
# TECHNICAL.md "Rate limiting".
RATE_LIMIT_HASH_SECRET=

# --- End-to-end tests (Playwright + Firebase emulators) — TEST ONLY ---
#
# You do NOT need to set anything here for normal development or deployment.
# The Playwright E2E suite (`npm run test:e2e`) sets all of the following
# automatically, pointing the app at LOCAL Firebase emulators backed by a
# disposable `demo-` project — never real Firebase, and never any secret. They
# are listed here only so their purpose is discoverable. See docs/TESTING.md
# "End-to-end tests (Playwright)".
#
# These MUST NEVER be set in a deployed Vercel environment. When the server
# (Admin SDK) sees the emulator hosts it enters emulator mode; a hard guard in
# src/lib/firebase/admin.ts refuses to run emulator mode in Vercel
# Production/Preview, and the E2E safety guard refuses to run against any
# non-demo project.
#
#   Server (Admin SDK) — set by `firebase emulators:exec`:
#     FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#     FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#     FIREBASE_ADMIN_PROJECT_ID=demo-saba-water-delivery
#
#   Client (browser, build-time NEXT_PUBLIC_*) — set by playwright.config.ts:
#     NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#     NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#     (plus demo NEXT_PUBLIC_FIREBASE_* values)
